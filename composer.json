{
	"name": "indieweb/indiewebify-me-slim",
	"description": "SlimPHP migration of IndieWebify.me",
	"type": "project",
	"require": {
		"php": "^8.5",
		"barnabywalters/mf-cleaner": "^0.2",
		"guzzlehttp/guzzle": "^7.0",
		"indieweb/rel-me": "^0.1.1",
		"mf2/mf2": "^0.5",
		"php-di/slim-bridge": "^3.4",
		"slim/psr7": "^1.7",
		"slim/slim": "^4.0",
		"slim/twig-view": "^3.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	}
}
