<h3>Check your <b>posts</b> are marked up with <a href="https://microformats.org/wiki/h-entry" target="_blank">h-entry</a>:</h3>

{% if error %}
    <div class="alert alert-danger"> {{ error }} </div>
{% endif %}

{% if report is defined and not report.found %}
    <div class="alert alert-danger"> No h-entry was found on {{ report.url }} </div>
{% endif %}

<form method="get" action="{{ url_for('validate_h_entry') }}" class="mb-3">
    <div class="row g-3">
        <div class="col">
            <input type="text" name="url" value="{{ url }}" class="form-control" placeholder="https://example.com/permalink" required>
        </div>
        <div class="col">
            <input type="submit" value="Validate h-entry" class="btn btn-primary">
        </div>
    </div>
</form>

{% if report is defined and report.found %}
    <div class="result alert alert-success my-4">
        <p>We found the following <b>{{ report.postType }}</b> <code>h-entry</code> on your site:</p>

		<div class="preview-h-entry">
			{% for check in report.checks %}
				{% include 'pages/partials/h-entry-check.twig' with { check: check } only %}
			{% endfor %}
		</div>
    </div>
{% endif %}

<small>Want to be able to use h-entry data in your code? Check out the open-source <a href="http://microformats.org/wiki/parsers">implementations</a>.</small>
