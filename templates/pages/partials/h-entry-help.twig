{% if help == 'name_probably_implicit' %}
    <p class="mb-2">The parsed <code>name</code> is longer than the content, which is usually a sign it is malformed due to being implicitly rather than explicitly parsed.</p>
{% elseif help == 'author_missing' %}
    <p class="mb-2">Add an author!</p>
    <code class="d-block">&lt;a rel="author" class="p-author h-card" href="…">Your Name&lt;/a></code>
{% elseif help == 'author_string_needs_hcard' %}
    <p class="mb-2">You’re marking up your post’s author as a string — add <code>h-card</code> to make it a full h-card!</p>
    <code class="d-block">&lt;a class="p-author h-card" href="…">{{ check.value.text|default('Your Name') }}&lt;/a></code>
{% elseif help == 'author_microformat_should_be_hcard' %}
    <p class="mb-2">The author is a nested microformat, but authors should be marked up as an <code>h-card</code>.</p>
    <code class="d-block">&lt;a class="p-author h-card" href="/">Your Name&lt;/a></code>
{% elseif help == 'author_unrecognized' %}
    <p class="mb-2">The author value was present, but it was not a readable string or nested microformat.</p>
{% elseif help == 'author_name_missing' %}
    <p class="mb-2">Add a name inside the author <code>h-card</code>.</p>
    <code class="d-block">&lt;span class="p-name">Your Name&lt;/span></code>
{% elseif help == 'author_url_missing' %}
    <p class="mb-2">Add a URL inside the author <code>h-card</code>. You can combine it with the author name.</p>
    <code class="d-block">&lt;a class="p-name u-url" href="/">Your Name&lt;/a></code>
{% elseif help == 'author_photo_missing' %}
    <p class="mb-2">Add a photo!</p>
    <code class="d-block">&lt;img class="u-photo" src="…" /></code>
{% elseif help == 'content_missing' %}
    <p class="mb-2">Add some content!</p>
    <code class="d-block">&lt;p class="e-content">…&lt;/p></code>
{% elseif help == 'content_prefer_e_content' %}
    <p class="mb-2">It looks like your content is marked up as a plain property — consider using <code>class="e-content"</code> so that consumers can parse rich text (i.e. with images and formatting)</p>
{% elseif help == 'published_missing' %}
    <p class="mb-2">Add a publication datetime!</p>
    <code class="d-block">&lt;time class="dt-published" datetime="YYYY-MM-DDTHH:MM:SS+00:00">The Date&lt;/time></code>
{% elseif help == 'published_malformed' %}
    <p class="mb-2">The datetime is not valid ISO-8601.</p>
{% elseif help == 'url_missing' %}
    <p class="mb-2">Add a URL!</p>
    <code class="d-block">&lt;a class="u-url" href="…">…&lt;/a></code>
{% elseif help == 'url_malformed' %}
    <p class="mb-2">The parsed post URL does not look like an absolute URL.</p>
{% elseif help == 'category_missing' %}
    <p class="mb-2">Add some categories!</p>
    <code class="d-block">&lt;a class="p-category" href="…">…&lt;/a></code>
{% elseif help == 'rsvp_missing' %}
    <p class="mb-2">The post looks like an RSVP, but no RSVP value was parsed.</p>
    <code class="d-block">&lt;data class="p-rsvp" value="yes">I’m going&lt;/data></code>
{% elseif help == 'rsvp_invalid' %}
    <p class="mb-2">RSVP should be one of <code>yes</code>, <code>no</code>, <code>maybe</code>, or <code>interested</code>.</p>
    <code class="d-block">&lt;data class="p-rsvp" value="yes">I’m going&lt;/data></code>
{% elseif help == 'interaction_intent_detected_no_value' %}
    <p class="mb-2">The HTML suggests this interaction target, but no value was parsed. Check that the class is on a URL-bearing element.</p>
{% elseif help == 'interaction_target_missing_url' %}
    <p class="mb-2">Give the nested microformat a URL property!</p>
    <code class="d-block">&lt;a class="u-url" href="…">&lt;/a></code>
{% elseif help == 'interaction_target_should_be_h_cite' %}
    <p class="mb-2">The nested microformat should be an <a href="http://microformats.org/wiki/h-cite"><code>h-cite</code></a> as it refers to off-site content.</p>
{% elseif help == 'interaction_target_malformed_url' %}
    <p class="mb-2">The value for this property should be a URL or an embedded <a href="http://microformats.org/wiki/h-cite"><code>h-cite</code></a>.</p>
{% else %}
    <p class="mb-2"><i>{{ help }}</i></p>
{% endif %}
